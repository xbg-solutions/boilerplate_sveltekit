{
  "name": "@xbg.solutions/create-frontend",
  "version": "1.0.0",
  "description": "CLI tool to scaffold and sync XBG frontend projects",
  "main": "lib/cli.js",
  "type": "module",
  "bin": {
    "create-xbg-frontend": "bin/create-frontend.js"
  },
  "files": ["lib", "bin"],
  "scripts": {
