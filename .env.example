# =============================================================================
# SVELTEKIT 5 BOILERPLATE - ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env and fill in your actual values
# Never commit .env to version control - it's already in .gitignore
# =============================================================================

# -----------------------------------------------------------------------------
# PROJECT CONFIGURATION
# -----------------------------------------------------------------------------
# Your application's basic information
VITE_APP_NAME="Your App Name"
VITE_APP_SHORT_NAME="YourApp" 
VITE_APP_DESCRIPTION="Your app description for SEO and social sharing"
VITE_APP_VERSION="1.0.0"
VITE_APP_DOMAIN="yourapp.com"

# Environment settings
NODE_ENV="development"  # development | production | test
PUBLIC_ENVIRONMENT="development"

# -----------------------------------------------------------------------------
# FIREBASE CONFIGURATION  
# -----------------------------------------------------------------------------
# Get these values from Firebase Console > Project Settings > General Tab
# https://console.firebase.google.com/project/YOUR_PROJECT/settings/general
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_API_KEY="your-firebase-api-key-here"
VITE_FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
VITE_FIREBASE_STORAGE_BUCKET="your-project-id.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789012"
VITE_FIREBASE_APP_ID="1:123456789012:web:abcdef123456789012345"
VITE_FIREBASE_MEASUREMENT_ID="G-XXXXXXXXXX"  # Optional: Google Analytics

# Firebase Emulator Configuration (for local development)
# VITE_FIREBASE_AUTH_EMULATOR_HOST="localhost"
# VITE_FIREBASE_AUTH_EMULATOR_PORT="9099"
# VITE_FIREBASE_FIRESTORE_EMULATOR_HOST="localhost" 
# VITE_FIREBASE_FIRESTORE_EMULATOR_PORT="8080"
# VITE_FIREBASE_STORAGE_EMULATOR_HOST="localhost"
# VITE_FIREBASE_STORAGE_EMULATOR_PORT="9199"

# -----------------------------------------------------------------------------
# API CONFIGURATION
# -----------------------------------------------------------------------------
# Your API endpoints for different environments
VITE_API_BASE_URL_DEV="http://localhost:5001/your-project-id/us-central1/api"
VITE_API_BASE_URL_PROD="https://us-central1-your-project-id.cloudfunctions.net/api"

# API request configuration
VITE_API_TIMEOUT="30000"  # Request timeout in milliseconds
VITE_API_RETRY_COUNT="3"  # Number of retry attempts
VITE_API_RETRY_DELAY="1000"  # Delay between retries in milliseconds

# -----------------------------------------------------------------------------
# AUTHENTICATION CONFIGURATION
# -----------------------------------------------------------------------------
# reCAPTCHA configuration (for phone auth)
# Get from https://console.cloud.google.com/security/recaptcha
VITE_RECAPTCHA_SITE_KEY="your-recaptcha-site-key-here"

# Auth behavior settings
VITE_AUTH_PERSISTENCE="local"  # local | session | none
VITE_AUTH_TIMEOUT="3600000"    # Session timeout in milliseconds (1 hour)

# Default user creation settings
VITE_CREATE_USER_ON_FIRST_SIGNIN="true"  # Auto-create user profile on first login
VITE_DEFAULT_USER_ROLE="user"             # Default role for new users

# -----------------------------------------------------------------------------
# FILE UPLOAD & STORAGE CONFIGURATION
# -----------------------------------------------------------------------------
# Firebase Storage settings
VITE_STORAGE_MAX_FILE_SIZE="10485760"     # 10MB in bytes
VITE_STORAGE_ALLOWED_TYPES="image/*,application/pdf,text/*"
VITE_STORAGE_UPLOAD_PATH="uploads/{userId}/{timestamp}"

# Image processing
VITE_IMAGE_MAX_WIDTH="1920"
VITE_IMAGE_MAX_HEIGHT="1080"
VITE_IMAGE_QUALITY="0.8"  # JPEG compression quality (0.1 - 1.0)

# -----------------------------------------------------------------------------
# CACHING CONFIGURATION
# -----------------------------------------------------------------------------
# API response caching
VITE_CACHE_TTL="300000"           # Cache TTL in milliseconds (5 minutes)
VITE_CACHE_MAX_SIZE="50"          # Maximum cached items
VITE_CACHE_STORAGE_TYPE="memory"  # memory | localStorage | sessionStorage

# Asset caching
VITE_ASSET_CACHE_VERSION="1.0.0"  # Increment to invalidate all caches

# -----------------------------------------------------------------------------
# SECURITY CONFIGURATION
# -----------------------------------------------------------------------------
# CSRF Protection
VITE_CSRF_ENABLED="true"
VITE_CSRF_HEADER_NAME="X-CSRF-Token"
VITE_CSRF_TOKEN_LENGTH="32"

# Content Security Policy
VITE_CSP_ENABLED="true"
VITE_CSP_REPORT_URI="/api/csp-report"

# Rate limiting
VITE_RATE_LIMIT_REQUESTS="100"  # Requests per window
VITE_RATE_LIMIT_WINDOW="900000"  # Window size in milliseconds (15 minutes)

# -----------------------------------------------------------------------------
# DEVELOPMENT & DEBUGGING
# -----------------------------------------------------------------------------
# Logging configuration
VITE_LOG_LEVEL="info"      # error | warn | info | debug
VITE_LOG_PERSIST="false"   # Persist logs in localStorage
VITE_LOG_MAX_ENTRIES="100" # Maximum log entries to keep

# Development features
VITE_DEBUG_MODE="false"         # Enable debug mode
VITE_SHOW_DEV_TOOLS="false"     # Show development tools in UI
VITE_MOCK_API="false"           # Use mock API responses

# Performance monitoring
VITE_PERFORMANCE_MONITORING="false"  # Enable performance tracking
VITE_ERROR_REPORTING="false"         # Enable error reporting service

# -----------------------------------------------------------------------------
# ANALYTICS & MONITORING
# -----------------------------------------------------------------------------
# Google Analytics (optional)
VITE_GA_TRACKING_ID="G-XXXXXXXXXX"
VITE_GA_ENABLED="false"

# Custom analytics endpoint (optional)
VITE_ANALYTICS_ENDPOINT=""
VITE_ANALYTICS_API_KEY=""

# Error monitoring service (Sentry-compatible)
VITE_ERROR_MONITORING_DSN=""
VITE_ERROR_MONITORING_ENABLED="false"

# -----------------------------------------------------------------------------
# EMAIL CONFIGURATION (if using server-side email)
# -----------------------------------------------------------------------------
# SMTP settings for server-side functions
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"  # true for 465, false for other ports
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"

# Email templates
VITE_EMAIL_FROM_NAME="Your App Name"
VITE_EMAIL_FROM_ADDRESS="noreply@yourapp.com"
VITE_EMAIL_REPLY_TO="support@yourapp.com"

# -----------------------------------------------------------------------------
# SOCIAL AUTH (if implementing OAuth providers)
# -----------------------------------------------------------------------------
# Google OAuth
VITE_GOOGLE_CLIENT_ID="123456789012-abcdefghijklmnopqrstuvwxyz.apps.googleusercontent.com"

# GitHub OAuth  
VITE_GITHUB_CLIENT_ID="Iv1.abcdef1234567890"

# Facebook OAuth
VITE_FACEBOOK_APP_ID="123456789012345"

# -----------------------------------------------------------------------------
# THIRD-PARTY INTEGRATIONS
# -----------------------------------------------------------------------------
# Stripe (if implementing payments)
VITE_STRIPE_PUBLISHABLE_KEY="your-stripe-publishable-key-here"
STRIPE_SECRET_KEY="your-stripe-secret-key-here"  # Server-side only
STRIPE_WEBHOOK_SECRET="your-stripe-webhook-secret-here"  # Server-side only

# Other service API keys
VITE_MAPS_API_KEY=""           # Google Maps API key
VITE_ANALYTICS_KEY=""          # Custom analytics service
VITE_CDN_URL=""                # CDN base URL for assets

# =============================================================================
# SETUP INSTRUCTIONS
# =============================================================================
# 1. Copy this file to .env: cp .env.example .env
# 2. Update all values with "your-" prefix
# 3. Get Firebase config from: https://console.firebase.google.com
# 4. Enable required Firebase services: Authentication, Firestore, Storage
# 5. Set up reCAPTCHA: https://console.cloud.google.com/security/recaptcha
# 6. Configure your domain in Firebase Auth settings
# 7. Test the configuration: npm run dev
# =============================================================================