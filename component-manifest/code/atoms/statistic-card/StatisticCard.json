{
  "id": "statisticcard",
  "name": "StatisticCard",
  "category": "atoms",
  "group": "statistic-card",
  "title": "Statistic Card",
  "description": "Displays a number metric with label and percentage-change indicator.",
  "tags": [
    "dashboard",
    "kpi",
