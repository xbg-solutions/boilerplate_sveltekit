  "source": "<!--\n  PlaygroundBlock02.svelte\n  AI playground with separate Input and Instructions textareas plus parameter panel.\n-->\n<script lang=\"ts\">\n  import { cn } from '$lib/utils/cn';\n  import {\n    Button,\n    Input,\n    Label,\n    Select,\n    Textarea\n  } from '$lib/components/ui';\n\n  let {\n    class: className = '',\n    models = [\n      { value: 'gpt-4', label: 'GPT-4' },\n      { value: 'gpt-3.5', label: 'GPT-3.5 Turbo' },\n      { value: 'claude-3', label: 'Claude 3' }\n    ]\n  }: {\n    class?: string;\n    models?: Array<{ value: string; label: string }>;\n  } = $props();\n\n  let selectedModel = $state(models[0]?.value ?? '');\n  let inputText = $state('');\n  let instructions = $state('');\n  let output = $state('');\n  let temperature = $state(0.7);\n  let maxLength = $state(256);\n  let topP = $state(0.9);\n</script>\n\n<div class={cn('flex h-screen flex-col', className)}>\n  <!-- Header -->\n  <div class=\"flex items-center justify-between border-b px-4 py-3\">\n    <h1 class=\"text-lg font-semibold\">Playground</h1>\n    <div class=\"flex items-center gap-2\">\n      <Select\n        options={models}\n        bind:value={selectedModel}\n        placeholder=\"Select model\"\n      />\n      <Button variant=\"outline\" size=\"sm\">Save</Button>\n      <Button variant=\"outline\" size=\"sm\">\n        <!-- Lucide: Code -->\n        View code\n      </Button>\n      <Button variant=\"outline\" size=\"sm\">\n        <!-- Lucide: Share -->\n        Share\n      </Button>\n    </div>\n  </div>\n\n  <!-- Main Area -->\n  <div class=\"flex flex-1 overflow-hidden\">\n    <!-- Left: Input + Output -->\n    <div class=\"flex flex-1 flex-col gap-4 p-4\">\n      <!-- Input Section -->\n      <div class=\"space-y-2\">\n        <Label>Input</Label>\n        <Textarea\n          placeholder=\"Enter your input here...\"\n          bind:value={inputText}\n          class=\"min-h-[120px] resize-none\"\n        />\n      </div>\n\n      <!-- Main Output Area -->\n      <div class=\"flex-1 space-y-2\">\n        <Label>Output</Label>\n        <Textarea\n          placeholder=\"Output will appear here...\"\n          bind:value={output}\n          class=\"min-h-[200px] flex-1 resize-none\"\n        />\n      </div>\n\n      <!-- Instructions -->\n      <div class=\"space-y-2\">\n        <Label>Instructions</Label>\n        <Textarea\n          placeholder=\"Enter instructions for the model...\"\n          bind:value={instructions}\n          class=\"min-h-[100px] resize-none\"\n        />\n      </div>\n\n      <!-- Footer -->\n      <div class=\"flex items-center gap-2\">\n        <Button>Submit</Button>\n        <Button variant=\"ghost\" size=\"sm\">\n          <!-- Lucide: RotateCcw -->\n          <span class=\"text-xs\">Reset</span>\n        </Button>\n      </div>\n    </div>\n\n    <!-- Right Panel: Parameters -->\n    <aside class=\"w-72 shrink-0 border-l bg-background p-4\">\n      <div class=\"space-y-6\">\n        <div class=\"space-y-2\">\n          <Label>Model</Label>\n          <Select\n            options={models}\n            bind:value={selectedModel}\n            placeholder=\"Select model\"\n          />\n        </div>\n\n        <div class=\"space-y-2\">\n          <div class=\"flex items-center justify-between\">\n            <Label>Temperature</Label>\n            <span class=\"text-sm text-muted-foreground\">{temperature}</span>\n          </div>\n          <input\n            type=\"range\"\n            min=\"0\"\n            max=\"2\"\n            step=\"0.1\"\n            bind:value={temperature}\n            class=\"w-full accent-primary\"\n          />\n        </div>\n\n        <div class=\"space-y-2\">\n          <Label>Maximum Length</Label>\n          <Input\n            type=\"number\"\n            bind:value={maxLength}\n            min={1}\n            max={4096}\n          />\n        </div>\n\n        <div class=\"space-y-2\">\n          <div class=\"flex items-center justify-between\">\n            <Label>Top P</Label>\n            <span class=\"text-sm text-muted-foreground\">{topP}</span>\n          </div>\n          <input\n            type=\"range\"\n            min=\"0\"\n            max=\"1\"\n            step=\"0.05\"\n            bind:value={topP}\n            class=\"w-full accent-primary\"\n          />\n        </div>\n      </div>\n    </aside>\n  </div>\n</div>\n",
  "imports": [
