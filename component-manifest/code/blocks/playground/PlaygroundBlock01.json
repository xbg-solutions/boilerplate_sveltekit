  "source": "<!--\n  PlaygroundBlock01.svelte\n  Simple AI playground with model selector, textarea, and parameter panel.\n-->\n<script lang=\"ts\">\n  import { cn } from '$lib/utils/cn';\n  import {\n    Button,\n    Input,\n    Label,\n    Select,\n    Textarea,\n    Tabs,\n    TabsList,\n    TabsTrigger,\n    TabsContent\n  } from '$lib/components/ui';\n  import Separator from '$lib/components/ui/Separator.svelte';\n\n  let {\n    class: className = '',\n    models = [\n      { value: 'gpt-4', label: 'GPT-4' },\n      { value: 'gpt-3.5', label: 'GPT-3.5 Turbo' },\n      { value: 'claude-3', label: 'Claude 3' }\n    ]\n  }: {\n    class?: string;\n    models?: Array<{ value: string; label: string }>;\n  } = $props();\n\n  let selectedModel = $state(models[0]?.value ?? '');\n  let prompt = $state('');\n  let temperature = $state(0.7);\n  let maxLength = $state(256);\n  let topP = $state(0.9);\n  let activeTab = $state('complete');\n</script>\n\n<div class={cn('flex h-screen flex-col', className)}>\n  <!-- Header -->\n  <div class=\"flex items-center justify-between border-b px-4 py-3\">\n    <h1 class=\"text-lg font-semibold\">Playground</h1>\n    <div class=\"flex items-center gap-2\">\n      <Select\n        options={models}\n        bind:value={selectedModel}\n        placeholder=\"Select model\"\n      />\n      <Button variant=\"outline\" size=\"sm\">Save</Button>\n      <Button variant=\"outline\" size=\"sm\">\n        <!-- Lucide: Code -->\n        View code\n      </Button>\n      <Button variant=\"outline\" size=\"sm\">\n        <!-- Lucide: Share -->\n        Share\n      </Button>\n    </div>\n  </div>\n\n  <!-- Main Area -->\n  <div class=\"flex flex-1 overflow-hidden\">\n    <!-- Prompt Area -->\n    <div class=\"flex flex-1 flex-col p-4\">\n      <Tabs value={activeTab}>\n        <TabsList>\n          <TabsTrigger value=\"complete\">Complete</TabsTrigger>\n          <TabsTrigger value=\"insert\">Insert</TabsTrigger>\n          <TabsTrigger value=\"edit\">Edit</TabsTrigger>\n        </TabsList>\n\n        <TabsContent value=\"complete\" class=\"flex-1\">\n          <Textarea\n            placeholder=\"Write a tagline for an ice cream shop...\"\n            bind:value={prompt}\n            class=\"min-h-[300px] resize-none\"\n          />\n        </TabsContent>\n\n        <TabsContent value=\"insert\">\n          <Textarea\n            placeholder=\"Insert text here...\"\n            bind:value={prompt}\n            class=\"min-h-[300px] resize-none\"\n          />\n        </TabsContent>\n\n        <TabsContent value=\"edit\">\n          <Textarea\n            placeholder=\"Edit prompt...\"\n            bind:value={prompt}\n            class=\"min-h-[300px] resize-none\"\n          />\n        </TabsContent>\n      </Tabs>\n\n      <!-- Footer -->\n      <div class=\"mt-4 flex items-center gap-2\">\n        <Button>Submit</Button>\n        <Button variant=\"ghost\" size=\"sm\">\n          <!-- Lucide: RotateCcw -->\n          <span class=\"text-xs\">Reset</span>\n        </Button>\n      </div>\n    </div>\n\n    <!-- Right Panel: Parameters -->\n    <aside class=\"w-72 shrink-0 border-l bg-background p-4\">\n      <div class=\"space-y-6\">\n        <div class=\"space-y-2\">\n          <Label>Model</Label>\n          <Select\n            options={models}\n            bind:value={selectedModel}\n            placeholder=\"Select model\"\n          />\n        </div>\n\n        <div class=\"space-y-2\">\n          <div class=\"flex items-center justify-between\">\n            <Label>Temperature</Label>\n            <span class=\"text-sm text-muted-foreground\">{temperature}</span>\n          </div>\n          <input\n            type=\"range\"\n            min=\"0\"\n            max=\"2\"\n            step=\"0.1\"\n            bind:value={temperature}\n            class=\"w-full accent-primary\"\n          />\n        </div>\n\n        <div class=\"space-y-2\">\n          <Label>Maximum Length</Label>\n          <Input\n            type=\"number\"\n            bind:value={maxLength}\n            min={1}\n            max={4096}\n          />\n        </div>\n\n        <div class=\"space-y-2\">\n          <div class=\"flex items-center justify-between\">\n            <Label>Top P</Label>\n            <span class=\"text-sm text-muted-foreground\">{topP}</span>\n          </div>\n          <input\n            type=\"range\"\n            min=\"0\"\n            max=\"1\"\n            step=\"0.05\"\n            bind:value={topP}\n            class=\"w-full accent-primary\"\n          />\n        </div>\n      </div>\n    </aside>\n  </div>\n</div>\n",
  "imports": [
