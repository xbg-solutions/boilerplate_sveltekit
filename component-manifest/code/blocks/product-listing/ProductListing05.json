{
  "id": "productlisting05",
  "name": "ProductListing05",
  "category": "blocks",
  "group": "product-listing",
  "title": "Wishlist / Saved Items",
  "description": "4-col saved product grid with remove and add-to-cart per card.",
  "tags": [
    "product",
