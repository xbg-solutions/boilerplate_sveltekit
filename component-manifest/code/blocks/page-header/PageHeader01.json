  "source": "<!--\n  PageHeader01.svelte\n  Minimal two-slot horizontal layout: wide left slot + narrow right slot.\n-->\n<script lang=\"ts\">\n  import { cn } from '$lib/utils/cn';\n  import type { Snippet } from 'svelte';\n\n  let {\n    class: className = '',\n    left,\n    right\n  }: {\n    class?: string;\n    left?: Snippet;\n    right?: Snippet;\n  } = $props();\n</script>\n\n<div class={cn('flex items-start gap-4 py-4', className)}>\n  <div class=\"flex-1\">\n    {#if left}\n      {@render left()}\n    {:else}\n      <div class=\"flex min-h-14 items-center justify-center rounded-lg border border-dashed bg-background text-sm text-muted-foreground\">\n        Slot (swap it with your content)\n      </div>\n    {/if}\n  </div>\n  <div class=\"w-56 shrink-0\">\n    {#if right}\n      {@render right()}\n    {:else}\n      <div class=\"flex min-h-14 items-center justify-center rounded-lg border border-dashed bg-background text-sm text-muted-foreground\">\n        Slot (swap it with your content)\n      </div>\n    {/if}\n  </div>\n</div>\n",
