  "id": "testimonial06",
  "name": "Testimonial06",
  "category": "blocks",
  "group": "testimonials",
  "title": "Testimonial 06",
  "description": "Customer testimonial sections in various layouts — single centred, card grids, split with image, dark, and masonry.",
  "tags": [
    "testimonials",
    "social-proof",
    "landing-page"
  ],
  "source": "<script lang=\"ts\">\n\timport { cn } from '$lib/utils/cn';\n\n\tinterface Testimonial {\n\t\tquote: string;\n\t\tname: string;\n\t\trole?: string;\n\t\tcompany?: string;\n\t\tavatarUrl?: string;\n\t\trating?: number;\n\t}\n\n\tinterface Props {\n\t\tclass?: string;\n\t\ttitle?: string;\n\t\tdescription?: string;\n\t\ttestimonials?: Testimonial[];\n\t}\n\n\tconst defaultTestimonial: Testimonial = {\n\t\tquote:\n\t\t\t'\"Shadcn UI Kit for Figma has completely transformed our design process. It\\'s incredibly intuitive and saves us so much time. The components are beautifully crafted and customizable.\"',\n\t\tname: 'Lando Norris',\n\t\trole: 'CEO',\n\t\tcompany: 'Acme Inc.',\n\t\trating: 5\n\t};\n\n\tlet {\n\t\tclass: className,\n\t\ttitle = 'What our customers say',\n\t\tdescription,\n\t\ttestimonials = [\n\t\t\tdefaultTestimonial,\n\t\t\tdefaultTestimonial,\n\t\t\tdefaultTestimonial,\n\t\t\tdefaultTestimonial\n\t\t]\n\t}: Props = $props();\n\n\tconst getInitials = (name: string): string => {\n\t\treturn name\n\t\t\t.split(' ')\n\t\t\t.map((w) => w[0])\n\t\t\t.join('')\n\t\t\t.toUpperCase();\n\t};\n</script>\n\n<section class={cn('w-full bg-background py-16 px-4 sm:px-6 lg:px-8', className)}>\n\t<div class=\"mx-auto max-w-6xl\">\n\t\t<div>\n\t\t\t<p class=\"text-sm font-semibold text-muted-foreground uppercase tracking-widest\">\n\t\t\t\tTestimonials Section\n\t\t\t</p>\n\t\t\t<h2 class=\"mt-2 text-3xl font-bold tracking-tight text-foreground\">{title}</h2>\n\t\t\t{#if description}\n\t\t\t\t<p class=\"mt-4 text-base text-muted-foreground\">{description}</p>\n\t\t\t{/if}\n\t\t</div>\n\n\t\t<div class=\"mt-10 grid grid-cols-1 gap-6 sm:grid-cols-2\">\n\t\t\t{#each testimonials as testimonial}\n\t\t\t\t<div class=\"rounded-lg border bg-background p-6\">\n\t\t\t\t\t<div class=\"flex gap-1\">\n\t\t\t\t\t\t{#each Array(5) as _, i}\n\t\t\t\t\t\t\t<svg\n\t\t\t\t\t\t\t\twidth=\"16\"\n\t\t\t\t\t\t\t\theight=\"16\"\n\t\t\t\t\t\t\t\tviewBox=\"0 0 24 24\"\n\t\t\t\t\t\t\t\tfill={i < (testimonial.rating || 5) ? '#f59e0b' : 'none'}\n\t\t\t\t\t\t\t\tstroke=\"#f59e0b\"\n\t\t\t\t\t\t\t\tstroke-width=\"2\"\n\t\t\t\t\t\t\t>\n\t\t\t\t\t\t\t\t<polygon points=\"12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2\" />\n\t\t\t\t\t\t\t</svg>\n\t\t\t\t\t\t{/each}\n\t\t\t\t\t</div>\n\n\t\t\t\t\t<p class=\"text-sm text-muted-foreground mt-3\">{testimonial.quote}</p>\n\n\t\t\t\t\t<div class=\"mt-4 pt-4 flex items-center gap-3\">\n\t\t\t\t\t\t{#if testimonial.avatarUrl}\n\t\t\t\t\t\t\t<img\n\t\t\t\t\t\t\t\tsrc={testimonial.avatarUrl}\n\t\t\t\t\t\t\t\talt={testimonial.name}\n\t\t\t\t\t\t\t\tclass=\"h-10 w-10 rounded-full object-cover\"\n\t\t\t\t\t\t\t/>\n\t\t\t\t\t\t{:else}\n\t\t\t\t\t\t\t<div\n\t\t\t\t\t\t\t\tclass=\"h-10 w-10 rounded-full bg-muted overflow-hidden flex items-center justify-center text-muted-foreground text-xs font-semibold\"\n\t\t\t\t\t\t\t>\n\t\t\t\t\t\t\t\t{getInitials(testimonial.name)}\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t{/if}\n\n\t\t\t\t\t\t<div>\n\t\t\t\t\t\t\t<p class=\"font-semibold text-sm text-foreground\">{testimonial.name}</p>\n\t\t\t\t\t\t\t{#if testimonial.role || testimonial.company}\n\t\t\t\t\t\t\t\t<p class=\"text-xs text-muted-foreground\">\n\t\t\t\t\t\t\t\t\t{testimonial.role}\n\t\t\t\t\t\t\t\t\t{#if testimonial.role && testimonial.company}\n\t\t\t\t\t\t\t\t\t\t·\n\t\t\t\t\t\t\t\t\t{/if}\n\t\t\t\t\t\t\t\t\t{testimonial.company}\n\t\t\t\t\t\t\t\t</p>\n\t\t\t\t\t\t\t{/if}\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t{/each}\n\t\t</div>\n\t</div>\n</section>\n",
  "imports": [
    {
      "specifiers": [
        "cn"
      ],
      "from": "$lib/utils/cn"
    }
  ],
  "figmaNodeId": null,
  "playgroundUrl": "https://svelte.dev/playground/untitled#"
}