  "source": "<script lang=\"ts\">\n\timport { cn } from '$lib/utils/cn';\n\n\tinterface Props {\n\t\tclass?: string;\n\t\tonNew?: () => void;\n\t\tonEdit?: () => void;\n\t\tonSend?: () => void;\n\t\tonMore?: () => void;\n\t}\n\n\tconst { class: className = '', onNew, onEdit, onSend, onMore } = $props();\n</script>\n\n<div class={cn('inline-flex rounded-md border overflow-hidden divide-x', className)}>\n\t<button\n\t\ttype=\"button\"\n\t\tonclick={onNew}\n\t\tclass=\"flex items-center gap-1.5 px-3 py-1.5 text-sm bg-background hover:bg-muted transition-colors\"\n\t>\n\t\t<svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n\t\t\t<line x1=\"12\" y1=\"5\" x2=\"12\" y2=\"19\" />\n\t\t\t<line x1=\"5\" y1=\"12\" x2=\"19\" y2=\"12\" />\n\t\t</svg>\n\t\t<span>New</span>\n\t</button>\n\n\t<button\n\t\ttype=\"button\"\n\t\tonclick={onEdit}\n\t\tclass=\"flex items-center gap-1.5 px-3 py-1.5 text-sm bg-background hover:bg-muted transition-colors\"\n\t>\n\t\t<svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n\t\t\t<path d=\"M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7\" />\n\t\t\t<path d=\"M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z\" />\n\t\t</svg>\n\t\t<span>Edit</span>\n\t</button>\n\n\t<button\n\t\ttype=\"button\"\n\t\tonclick={onSend}\n\t\tclass=\"flex items-center gap-1.5 px-3 py-1.5 text-sm bg-background hover:bg-muted transition-colors\"\n\t>\n\t\t<svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n\t\t\t<line x1=\"22\" y1=\"2\" x2=\"11\" y2=\"13\" />\n\t\t\t<polygon points=\"22 2 15 22 11 13 2 9 22 2\" />\n\t\t</svg>\n\t\t<span>Send</span>\n\t</button>\n\n\t<button\n\t\ttype=\"button\"\n\t\tonclick={onMore}\n\t\tclass=\"flex items-center gap-1.5 px-3 py-1.5 text-sm bg-background hover:bg-muted transition-colors\"\n\t>\n\t\t<svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n\t\t\t<circle cx=\"12\" cy=\"12\" r=\"1\" />\n\t\t\t<circle cx=\"19\" cy=\"12\" r=\"1\" />\n\t\t\t<circle cx=\"5\" cy=\"12\" r=\"1\" />\n\t\t</svg>\n\t</button>\n</div>\n",
