  "source": "<!--\n  SidebarLayout02.svelte\n  Icon-only sidebar that expands on hover to show labels.\n-->\n<script lang=\"ts\">\n  import type { Snippet } from 'svelte';\n  import { cn } from '$lib/utils/cn';\n  import { Button } from '$lib/components/ui';\n  import { DynamicIcon } from '$lib/components/ui/icon';\n\n  let {\n    class: className = '',\n    items = [],\n    children\n  }: {\n    class?: string;\n    items?: Array<{\n      icon: string;\n      label: string;\n      href: string;\n      active?: boolean;\n    }>;\n    children?: Snippet;\n  } = $props();\n\n  let expanded = $state(false);\n</script>\n\n<div class={cn('flex h-screen', className)}>\n  <!-- Sidebar -->\n  <aside\n    class={cn(\n      'flex flex-col border-r bg-background transition-all duration-200',\n      expanded ? 'w-48' : 'w-16'\n    )}\n    onmouseenter={() => (expanded = true)}\n    onmouseleave={() => (expanded = false)}\n    role=\"navigation\"\n  >\n    <!-- Logo -->\n    <div class=\"flex h-14 items-center justify-center border-b\">\n      <!-- Lucide: Command -->\n      <span class=\"flex h-8 w-8 items-center justify-center rounded-md bg-primary text-sm font-bold text-primary-foreground\">\n        C\n      </span>\n    </div>\n\n    <!-- Nav Items -->\n    <nav class=\"flex flex-1 flex-col gap-1 p-2\">\n      {#each items as item}\n        <a\n          href={item.href}\n          class={cn(\n            'flex items-center gap-3 rounded-md px-3 py-2 text-sm transition-colors',\n            item.active\n              ? 'bg-muted font-medium text-foreground'\n              : 'text-muted-foreground hover:bg-muted hover:text-foreground'\n          )}\n          title={item.label}\n        >\n          <!-- Icon -->\n          <DynamicIcon name={item.icon} size={20} />\n          {#if expanded}\n            <span class=\"truncate\">{item.label}</span>\n          {/if}\n        </a>\n      {/each}\n    </nav>\n  </aside>\n\n  <!-- Main Content -->\n  <main class=\"flex-1 overflow-y-auto\">\n    {@render children?.()}\n  </main>\n</div>\n",
  "imports": [
