  "source": "<!--\n  LoginBlock03.svelte\n  Minimal email-only login form.\n-->\n<script lang=\"ts\">\n  import { cn } from '$lib/utils/cn';\n  import {\n    Button,\n    Card,\n    CardHeader,\n    CardContent,\n    CardTitle,\n    CardDescription,\n    Input,\n    Label\n  } from '$lib/components/ui';\n\n  let {\n    class: className = '',\n    onSubmit = undefined\n  }: {\n    class?: string;\n    onSubmit?: ((email: string) => void) | undefined;\n  } = $props();\n\n  let email = $state('');\n\n  function handleSubmit() {\n    onSubmit?.(email);\n  }\n</script>\n\n<div class={cn('flex min-h-screen items-center justify-center p-4', className)}>\n  <Card class=\"w-full max-w-md\">\n    <CardHeader>\n      <CardTitle class=\"text-2xl\">Login to your account</CardTitle>\n      <CardDescription>Enter your email below to login to your account</CardDescription>\n    </CardHeader>\n    <CardContent>\n      <form onsubmit={(e) => { e.preventDefault(); handleSubmit(); }} class=\"space-y-4\">\n        <div class=\"space-y-2\">\n          <Label htmlFor=\"login03-email\">Email</Label>\n          <Input\n            type=\"email\"\n            placeholder=\"m@example.com\"\n            bind:value={email}\n          />\n        </div>\n        <Button type=\"submit\" class=\"w-full\">Login</Button>\n      </form>\n    </CardContent>\n  </Card>\n</div>\n",
