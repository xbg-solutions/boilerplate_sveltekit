{
  "id": "productdetail01",
  "name": "ProductDetail01",
  "category": "blocks",
  "group": "product-detail",
  "title": "2-col Product Detail",
  "description": "Image gallery with thumbnails left; breadcrumb, name, rating, size selector, quantity stepper, and CTAs right.",
  "tags": [
    "product",
    "detail",
    "e-commerce",
