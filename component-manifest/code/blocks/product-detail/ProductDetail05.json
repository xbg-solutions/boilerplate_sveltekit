  "id": "productdetail05",
  "name": "ProductDetail05",
  "category": "blocks",
  "group": "product-detail",
  "title": "Sticky Sidebar",
  "description": "Scrollable gallery and description left, sticky price/options/CTA card right.",
  "tags": [
    "product",
