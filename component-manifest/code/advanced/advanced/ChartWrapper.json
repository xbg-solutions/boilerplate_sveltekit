        "DropdownMenuItem",
        "DropdownMenuTrigger",
        "DropdownMenuSeparator"
      ],
      "from": "$lib/components/ui/dropdown-menu"
    },
    {
      "specifiers": [
        "Download",
        "RefreshCw",
        "Settings",
        "TrendingUp",
        "BarChart3",
        "PieChart",
        "LineChart",
        "Scatter3D",
        "AlertTriangle",
        "Maximize2",
        "X"
      ],
      "from": "lucide-svelte"
    }
  ],
