        "CardTitle",
        "CardContent",
        "CardFooter"
      ],
      "from": "$lib/components/ui/card"
    },
    {
      "specifiers": [
        "Badge"
      ],
      "from": "$lib/components/ui/badge"
    },
    {
      "specifiers": [
