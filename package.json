{
  "name": "boilerplate_frontend",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "workspaces": [
    "packages/core",
    "packages/test-utils-frontend",
    "packages/utils-*",
    "packages/create-frontend"
  ],
  "files": [
    "src",
    "static",
    "build.js",
    "svelte.config.js",
    "vite.config.ts",
    "tailwind.config.cjs",
    "postcss.config.cjs",
    "tsconfig.json",
    "tsconfig.app.json",
    ".env.example",
    "README.md"
  ],
  "scripts": {
    "dev": "vite dev",
    "build:vite": "vite build",
    "build": "node build.js",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:unit:watch": "vitest --config vitest.unit.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:integration:watch": "vitest --config vitest.integration.config.ts",
    "test:coverage": "vitest run --coverage --config vitest.unit.config.ts",
    "test:coverage:integration": "vitest run --coverage --config vitest.integration.config.ts",
    "test:coverage:all": "npm run test:coverage && npm run test:coverage:integration",
    "test:coverage:ui": "vitest run --coverage --ui --config vitest.unit.config.ts",
    "test:a11y": "vitest run --config vitest.a11y.config.ts",
    "lint": "eslint . --ext .js,.ts,.svelte",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "analyze": "ANALYZE=true npm run build",
    "analyze:serve": "npm run analyze && npx serve dist",
    "perf:audit": "lighthouse http://localhost:4173 --output=json --output-path=./performance-audit.json",
    "perf:report": "npm run build && npm run preview & sleep 5 && npm run perf:audit && pkill -f preview",
    "deploy": "npm run build && firebase deploy --only hosting",
    "setup": "node __scripts__/setup.cjs",
    "validate": "node __scripts__/validate-setup.cjs",
    "validate:quick": "node __scripts__/validate-setup.cjs --quick",
    "manage-auth": "node __scripts__/manage-auth-users.cjs",
    "generate:component": "node __scripts__/generate-component.cjs",
    "generate:route": "node __scripts__/generate-route.cjs",
    "generate:service": "node __scripts__/generate-service.cjs",
    "build:packages": "npm run build --workspaces --if-present",
    "clean:packages": "npm run clean --workspaces --if-present",
    "postinstall": "echo '\n\u2705 Dependencies installed!\n\ud83d\ude80 Run npm run setup to configure your project\n'"
  },
  "devDependencies": {
    "@sveltejs/adapter-auto": "^4.0.0",
    "@sveltejs/adapter-static": "^3.0.8",
    "@sveltejs/kit": "^2.20.6",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@tailwindcss/typography": "^0.5.19",
    "@testing-library/jest-dom": "^6.9.0",
    "@testing-library/svelte": "^5.2.8",
    "@testing-library/user-event": "^14.6.1",
    "@tsconfig/svelte": "^5.0.4",
    "@typescript-eslint/eslint-plugin": "^8.57.0",
    "@typescript-eslint/parser": "^8.57.0",
    "@vitest/coverage-v8": "^3.2.4",
    "autoprefixer": "^10.4.16",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "eslint": "^10.0.1",
    "eslint-plugin-svelte": "^3.15.0",
    "firebase-admin": "^13.7.0",
    "jest-axe": "^10.0.0",
    "jsdom": "^24.1.3",
    "lucide-svelte": "^0.544.0",
    "postcss": "^8.4.31",
    "rollup-plugin-visualizer": "^6.0.3",
    "svelte-check": "^4.1.5",
    "tailwind-merge": "^3.3.1",
    "tailwind-variants": "^3.1.1",
    "terser": "^5.39.0",
    "typescript": "^5.8.2",
    "vite": "^6.4.2",
    "vite-bundle-analyzer": "^1.2.3"
  },
  "dependencies": {
    "@material-symbols/font-400": "^0.29.1",
    "@material-symbols/svg-400": "^0.29.1",
    "chart.js": "^4.5.1",
    "firebase": "^11.4.0",
    "simple-icons": "^16.11.0",
    "svelte": "^5.53.6",
    "tailwindcss": "^3.3.5",
    "vitest": "^3.0.8"
  },
  "overrides": {
    "cookie": "^1.0.2",
    "@tootallnate/once": "^3.0.1"
  }
}
