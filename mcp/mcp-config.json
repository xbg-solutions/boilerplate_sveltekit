    {
      "name": "search_documentation",
      "description": "Search across all documentation for specific keywords or concepts. Returns relevant documentation sections.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "Search query (keywords or concepts to find)"
          },
          "category": {
            "type": "string",
            "enum": ["all", "services", "utilities", "stores", "components", "guides"],
            "description": "Limit search to specific category (optional)",
            "default": "all"
          }
        },
        "required": ["query"]
      },
      "responseSchema": {
        "type": "object",
        "properties": {
          "results": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "file": {"type": "string"},
                "category": {"type": "string"},
                "relevance": {"type": "number"},
                "excerpt": {"type": "string"}
              }
            }
          }
        }
      }
    }
