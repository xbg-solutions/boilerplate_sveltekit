{
  "mcpServers": {
    "boilerplate-frontend-docs": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "/path/to/mcp/frontend"],
      "metadata": {
        "name": "XBG Boilerplate Frontend Documentation",
        "version": "1.0.0",
        "description": "MCP server for SvelteKit 5 AI-compatible boilerplate documentation",
        "provider": "XBG Solutions",
        "url": "https://xbg.solutions/boilerplates/mcp-config.json",
        "repository": "https://github.com/xbg-solutions/boilerplate_frontend"
      }
    }
  },
  "tools": [
    {
      "name": "get_project_overview",
      "description": "Get high-level overview of the SvelteKit 5 boilerplate project, including philosophy, architecture, and agentic development approach",
      "inputSchema": {
        "type": "object",
        "properties": {
          "section": {
            "type": "string",
            "enum": ["main", "getting-started", "quick-start", "agentic-development", "testing", "configuration", "deployment"],
            "description": "Which overview section to retrieve"
          }
        }
      },
      "responseSchema": {
        "type": "string",
        "description": "Markdown content from the requested overview document"
      },
      "files": {
        "main": "mcp/frontend/overview/README.md",
        "getting-started": "mcp/frontend/overview/getting-started.md",
        "quick-start": "mcp/frontend/overview/quick-start.md",
        "agentic-development": "mcp/frontend/guides/agentic-development.md",
        "testing": "mcp/frontend/guides/testing.md",
        "configuration": "mcp/frontend/guides/configuration.md",
        "deployment": "mcp/frontend/guides/deployment.md"
      }
    },
